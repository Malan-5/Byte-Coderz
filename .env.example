# SERVER ONLY. Copy to .env.local and fill in values there.
# Never prefix these variables with VITE_ or import them from src/.

# Supabase project URL and privileged service_role key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dispatcher passcode (at least 12 characters) and independent JWT signing secret.
# Generate JWT_SECRET with the command in README.md (at least 32 random bytes).
DISPATCHER_PASSCODE=
JWT_SECRET=

# Choose gemini or openai. Configure only the selected provider's key/model.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=

# Public application origin, read on the server for same-origin validation.
# Use your deployed https://...vercel.app origin in Vercel's environment settings.
APP_ORIGIN=http://localhost:3000

# Identify this app to the server-side OSM tile and Nominatim requests.
# Put a monitored contact address here; it is sent to the map services only.
OSM_CONTACT_EMAIL=

# Allows authenticated demo seeding/reset. Set false for non-demo use.
DEMO_MODE=true
