{
  "name": "disastermesh",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev --listen 3000",
    "check": "tsc --noEmit",
    "check:env": "node scripts/check-env.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "test": "node --import tsx --test tests/logic.test.ts tests/database.test.ts",
    "test:logic": "node --import tsx --test tests/logic.test.ts",
    "test:db": "node --import tsx --test tests/database.test.ts",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "vercel": "vercel"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "jose": "^6.0.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vercel/node": "23.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "vercel": "63.0.0",
    "vite": "^7.3.7"
  }
}
